<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dr. Katarzyna Szymaniak | Research Portfolio</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Custom Tailwind configuration for light/dark mode
        tailwind.config = {
            darkMode: 'class', // Enable dark mode using 'dark' class on <html>
            theme: {
                extend: {
                    colors: {
                        // Base colors for Dark Mode (Default)
                        'dark-bg': '#0f172a',    // Deep navy background (slate-900)
                        'dark-card': '#1e293b',  // Card background (slate-800)
                        'dark-text': '#f1f5f9',  // Light text (slate-100)
                        
                        // Base colors for Light Mode (Refined for better UI)
                        'light-bg': '#f9fafb',   // Very light gray (off-white)
                        'light-card': '#ffffff', // White card
                        'light-text': '#1f2937', // Dark gray (gray-900)

                        // Shared Accent Colors
                        'accent-blue': '#3b82f6', // blue-500
                        'accent-green': '#10b981', // emerald-500
                        'accent-purple': '#a855f7', // violet-500
                        
                        // Tag Colors (Using Indigo for tags)
                        'tag-bg-dark': 'rgba(129, 140, 248, 0.15)', 
                        'tag-text-dark': '#818cf8', 
                        'tag-bg-light': 'rgba(59, 130, 246, 0.1)', // Muted, very light blue
                        'tag-text-light': '#1d4ed8', // dark blue
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <style>
        /* Base styles applied to the body, using dark mode colors by default */
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--dark-bg); 
            color: var(--dark-text);
            min-height: 100vh;
            padding-bottom: 5rem;
            transition: background-color 0.3s, color 0.3s;
        }

        /* Variables for easy color switching (DARK MODE DEFAULTS) */
        :root {
            --bg-color: #0f172a;
            --card-color: #1e293b;
            --text-color: #f1f5f9;
            --secondary-text: #94a3b8;
            --border-color: #334155; /* slate-700 */
            --tag-bg: rgba(129, 140, 248, 0.15);
            --tag-text: #818cf8;
            --accent-blue: #3b82f6;
        }

        /* Light Mode overrides */
        html.light {
            --bg-color: #f9fafb; /* Soft white */
            --card-color: #ffffff; /* Pure white cards */
            --text-color: #1f2937; /* Dark gray */
            --secondary-text: #6b7280; /* Medium gray */
            --border-color: #e5e7eb; /* gray-200 */
            --tag-bg: rgba(59, 130, 246, 0.1); /* Very light blue */
            --tag-text: #1d4ed8; /* Dark blue */
        }

        /* Apply variables to key elements */
        body {
            background-color: var(--bg-color);
            color: var(--text-color);
        }

        .header-bg {
             background-color: var(--bg-color);
        }
        
        .nav-link, .mode-toggle {
            color: var(--text-color);
        }

        .card-style {
            background-color: var(--card-color);
            border-color: var(--border-color); /* Uses new variable */
        }

        .text-default {
            color: var(--text-color);
        }

        .text-secondary {
            color: var(--secondary-text);
        }

        .section-title {
            position: relative;
            padding-bottom: 0.5rem;
            margin-bottom: 1.5rem;
            color: var(--text-color);
        }
        .section-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            height: 3px;
            width: 50px;
            background-color: var(--accent-blue);
            border-radius: 9999px;
        }
        .project-link-button {
            transition: background-color 0.2s, transform 0.1s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            line-height: 1.25rem;
        }
        .project-link-button:hover {
            transform: translateY(-1px);
        }
        
        /* Tag styling using CSS variables for mode switch */
        .tag {
            background-color: var(--tag-bg);
            color: var(--tag-text);
            padding: 0.25rem 0.625rem;
            font-size: 0.7rem;
            font-weight: 600;
            border-radius: 0.375rem;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
            display: inline-flex;
            white-space: nowrap;
        }

        /* --- Custom Styles for the Professional Experience Timeline --- */
        .timeline-container {
            position: relative;
            margin-left: 20px; 
            padding-top: 10px;
        }

        .timeline-container::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 2px;
            background-color: var(--accent-blue); /* Accent blue line */
        }

        .timeline-item {
            position: relative;
            padding-left: 40px; 
            margin-bottom: 3rem; 
        }

        .timeline-marker {
            position: absolute;
            left: -10px; 
            top: 0;
            width: 22px;
            height: 22px;
            background-color: var(--bg-color); 
            border: 3px solid var(--accent-blue);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }

        .timeline-icon {
            width: 12px;
            height: 12px;
            color: var(--accent-blue); 
        }
        
        .experience-card-content {
            background-color: var(--card-color);
            padding: 1.5rem;
            border-radius: 0.75rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05); /* Lighter shadow for light mode */
            border: 1px solid var(--border-color);
        }
        /* --- End Timeline Styles --- */
        
        /* --- Custom Styles for Contact Icons --- */
        .contact-icon-link {
            display: inline-flex;
            width: 40px;
            height: 40px;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background-color: var(--card-color); 
            transition: background-color 0.2s, color 0.2s;
            color: var(--secondary-text);
            border: 1px solid var(--border-color);
        }

        .contact-icon-link:hover {
            background-color: var(--accent-blue); 
            color: #ffffff; /* White text on hover for contrast */
            border-color: var(--accent-blue);
        }
        /* --- End Contact Icons Styles --- */

        /* Custom style for the large KS profile circle */
        .ks-profile-circle {
            width: 16rem; 
            height: 16rem; 
            border-width: 4px;
            background-color: var(--card-color); 
            color: var(--text-color);
            border-color: var(--card-color);
            font-size: 6rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Adjusted styling for the new vertical layout */
        @media (min-width: 768px) {
            .home-grid {
                grid-template-columns: 1fr 2fr;
                align-items: center; 
            }
        }
    </style>
</head>
<body class="antialiased dark">

    <!-- JavaScript for Dark/Light Mode and Bold Text Processing -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const html = document.documentElement;
            const modeToggle = document.getElementById('mode-toggle');
            
            // Function to check system preference and local storage for default mode
            const getInitialMode = () => {
                if (localStorage.getItem('theme') === 'light') {
                    return 'light';
                }
                if (localStorage.getItem('theme') === 'dark') {
                    return 'dark';
                }
                // Default to dark if no preference is set
                return 'dark'; 
            };

            const setMode = (mode) => {
                if (mode === 'dark') {
                    html.classList.add('dark');
                    html.classList.remove('light');
                    localStorage.setItem('theme', 'dark');
                    modeToggle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>'; // Moon icon
                } else {
                    html.classList.add('light');
                    html.classList.remove('dark');
                    localStorage.setItem('theme', 'light');
                    modeToggle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>'; // Sun icon
                }
            };
            
            // Initial setup
            setMode(getInitialMode());

            // Toggle function
            window.toggleDarkMode = () => {
                const currentMode = html.classList.contains('dark') ? 'dark' : 'light';
                setMode(currentMode === 'dark' ? 'light' : 'dark');
            };

            // Helper function to process custom bold syntax **{}**
            const processTextForBold = (selector) => {
                const elements = document.querySelectorAll(selector);
                elements.forEach(element => {
                    let htmlContent = element.innerHTML;
                    // Regex to find **{text}** and replace it with <strong>text</strong>
                    htmlContent = htmlContent.replace(/\*\*{(.*?)}\*\*/g, '<strong>$1</strong>');
                    element.innerHTML = htmlContent;
                });
            };

            // Apply bold processing to all relevant text blocks
            processTextForBold('.text-process-bold');

            // Note: We no longer need the explicit updateColors function in JS 
            // because all dynamic colors are handled by CSS variables based on html.light/dark
        });
    </script>

