<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>Katarzyna Szymaniak — Biomedical AI · Adaptive ML for Biosignals & Wearables</title>
<meta name="description" content="Dr. Katarzyna Szymaniak — Biomedical AI researcher. PhD, University of Edinburgh. Adaptive machine learning for biosignals, wearables, and the messy distribution shifts of real human bodies." />
<meta name="author" content="Katarzyna Szymaniak" />
<meta property="og:title" content="Katarzyna Szymaniak — Biomedical AI Researcher" />
<meta property="og:description" content="Adaptive machine learning for biosignals, wearables, and the messy distribution shifts of real human bodies." />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://katarzynaszymaniak.github.io/" />
<meta property="og:image" content="https://katarzynaszymaniak.github.io/me.jpeg" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content="@szymaniak_kasia" />
<meta name="theme-color" content="#0a0a0c" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230a0a0c'/%3E%3Cpath d='M6 32 L18 32 L22 18 L30 46 L36 24 L42 38 L46 32 L58 32' stroke='%23d4a574' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..900,0..100,0..1&family=DM+Sans:opsz,wght@9..40,300..700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<script>
  // Pre-paint theme init: avoids flash on first load.
  (function () {
    try {
      var stored = localStorage.getItem('ks-theme');
      var prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
      if (stored === 'light' || (!stored && prefersLight)) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    } catch (_) { /* no-op */ }
  })();
</script>
<style>
  /* ------------------------------------------------------------
     0. tokens
     ------------------------------------------------------------ */
  :root {
    --bg:           #0a0a0c;
    --bg-elev:      #101015;
    --bg-card:      #14141a;
    --bg-card-hi:   #1a1a22;
    --fg:           #ece8de;
    --fg-strong:    #f6f3eb;
    --fg-muted:     #8a8478;
    --fg-dim:       #5a544a;
    --border:       rgba(236, 232, 222, 0.08);
    --border-strong:rgba(236, 232, 222, 0.16);
    --accent:       #d4a574;   /* copper / sand — human, warmth */
    --accent-dim:   #8a6d47;
    --signal:       #7ae5b8;   /* electric green — biosignal, sparingly */
    --signal-dim:   #2f6b54;
    --rust:         #e58a6e;
    --grain-opacity: 0.6;
    --grain-blend:   overlay;
    --serif:        'Fraunces', 'Iowan Old Style', 'Apple Garamond', Garamond, 'Times New Roman', serif;
    --sans:         'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --mono:         'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    --maxw:         1180px;
    --gutter:       clamp(20px, 4vw, 56px);
    --ease:         cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* light theme — warm cream paper with the same copper accent.
     Same skeleton, inverted contrast, signal hue shifted darker so it
     stays visible against bright backgrounds. */
  [data-theme="light"] {
    --bg:           #f4efe3;
    --bg-elev:      #faf6ec;
    --bg-card:      #fbf7ed;
    --bg-card-hi:   #ffffff;
    --fg:           #1c1a16;
    --fg-strong:    #0a0908;
    --fg-muted:     #6e6657;
    --fg-dim:       #9c937f;
    --border:       rgba(26, 22, 16, 0.10);
    --border-strong:rgba(26, 22, 16, 0.22);
    --accent:       #a8743e;   /* deeper copper for contrast on cream */
    --accent-dim:   #7a5530;
    --signal:       #1f8266;   /* deep teal-green — biosignal on paper */
    --signal-dim:   #14503f;
    --rust:         #b85a3a;
    --grain-opacity: 0.18;
    --grain-blend:   multiply;
  }
  /* smooth color crossfade when toggling */
  html { transition: background-color 0.5s var(--ease); }
  body, .nav, .nav-cv, .btn, .agenda-card, .proj, .outreach-card,
  .hero-portrait, .pub .links a, .socials a {
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease),
                border-color 0.4s var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }

  /* ------------------------------------------------------------
     1. base
     ------------------------------------------------------------ */
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    font-feature-settings: "ss01", "cv11";
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
  }
  /* film grain overlay — opacity & blend mode swap with theme */
  body::before {
    content: "";
    position: fixed; inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.9  0 0 0 0 0.85  0 0 0 0 0.75  0 0 0 0.035 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    opacity: var(--grain-opacity);
    mix-blend-mode: var(--grain-blend);
    z-index: 9999;
  }
  ::selection { background: var(--accent); color: var(--bg); }

  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; display: block; }
  button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }

  .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 var(--gutter); }

  /* typography */
  h1, h2, h3, h4 { font-family: var(--serif); font-weight: 400; letter-spacing: -0.02em; line-height: 1.05; margin: 0; font-variation-settings: "SOFT" 30, "WONK" 0; }
  h1 { font-size: clamp(56px, 10vw, 132px); letter-spacing: -0.035em; }
  h2 { font-size: clamp(36px, 5.5vw, 64px); }
  h3 { font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.015em; }
  h4 { font-size: 18px; font-family: var(--sans); font-weight: 500; letter-spacing: 0; }
  p { margin: 0 0 1em; }

  .serif-italic { font-family: var(--serif); font-style: italic; font-variation-settings: "SOFT" 100, "WONK" 1; }
  .mono { font-family: var(--mono); font-size: 0.82em; letter-spacing: 0.02em; }
  .muted { color: var(--fg-muted); }
  .dim   { color: var(--fg-dim); }
  .accent { color: var(--accent); }
  .signal { color: var(--signal); }

  /* curly-brace emphasis (echoes Kasia's own writing style) */
  .k { color: var(--fg-strong); font-weight: 500; white-space: nowrap; }
  .k::before, .k::after { color: var(--accent); font-family: var(--mono); font-weight: 400; opacity: 0.65; }
  .k::before { content: "{"; margin-right: 0.05em; }
  .k::after  { content: "}"; margin-left: 0.05em; }

  /* small tag pill */
  .tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255,255,255,0.015);
  }
  .tag.accent { color: var(--accent); border-color: color-mix(in oklab, var(--accent) 38%, transparent); }
  .tag.signal { color: var(--signal); border-color: color-mix(in oklab, var(--signal) 35%, transparent); }

  /* section header */
  .section-head {
    display: flex; align-items: baseline; gap: 18px;
    margin-bottom: clamp(36px, 5vw, 64px);
    border-top: 1px solid var(--border);
    padding-top: clamp(36px, 5vw, 56px);
  }
  .section-head .num {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.18em;
    color: var(--accent); text-transform: uppercase;
    flex-shrink: 0;
    padding-top: 0.5em;
  }
  .section-head .meta {
    margin-left: auto;
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em;
    color: var(--fg-dim); text-transform: uppercase;
    text-align: right;
  }
  .section-head h2 .serif-italic { color: var(--accent); }

  section { padding: clamp(60px, 8vw, 120px) 0; }

  /* ------------------------------------------------------------
     2. nav
     ------------------------------------------------------------ */
  .nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 100;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s var(--ease), background 0.4s var(--ease);
  }
  .nav.scrolled { border-bottom-color: var(--border); background: color-mix(in oklab, var(--bg) 88%, transparent); }
  .nav-inner {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 14px var(--gutter);
    display: flex; align-items: center; gap: 28px;
  }
  .brand {
    font-family: var(--serif); font-size: 19px; font-weight: 500; letter-spacing: -0.01em;
    display: flex; align-items: center; gap: 10px;
  }
  .brand .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--signal); box-shadow: 0 0 12px var(--signal); animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse {
    0%, 100% { opacity: 0.85; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }
  .nav-links { display: flex; gap: 34px; margin-left: auto; }
  .nav-links a {
    font-size: 18px; color: var(--fg-muted);
    transition: color 0.2s ease;
    position: relative;
    font-weight: 400;
    letter-spacing: -0.005em;
  }
  .nav-links a:hover { color: var(--fg); }
  .nav-cv {
    font-family: var(--mono); font-size: 14px; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--accent);
    border: 1px solid color-mix(in oklab, var(--accent) 42%, transparent);
    padding: 10px 18px; border-radius: 999px;
    transition: all 0.25s ease;
  }
  .brand { font-size: 24px; }
  .nav-inner { padding: 18px var(--gutter); gap: 28px; }
  .nav-cv:hover { background: var(--accent); color: var(--bg); border-color: var(--accent); }

  /* theme toggle — sun/moon swap, lives next to CV */
  .theme-toggle {
    width: 42px; height: 42px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    color: var(--fg-muted);
    cursor: pointer;
    transition: all 0.3s var(--ease);
    position: relative;
    overflow: hidden;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); transform: rotate(15deg); }
  .theme-toggle svg { width: 18px; height: 18px; transition: transform 0.5s var(--ease), opacity 0.3s ease; position: absolute; }
  .theme-toggle .moon { opacity: 1; transform: rotate(0deg) scale(1); }
  .theme-toggle .sun  { opacity: 0; transform: rotate(-90deg) scale(0.4); }
  [data-theme="light"] .theme-toggle .moon { opacity: 0; transform: rotate(90deg) scale(0.4); }
  [data-theme="light"] .theme-toggle .sun  { opacity: 1; transform: rotate(0deg) scale(1); }

  .nav-burger { display: none; margin-left: auto; gap: 10px; }
  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-burger { display: flex; align-items: center; gap: 10px; }
  }

  /* ------------------------------------------------------------
     3. hero
     ------------------------------------------------------------ */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    padding: 140px 0 200px;     /* extra bottom room so the EMG band lives fully inside */
    display: flex; flex-direction: column; justify-content: center;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  @media (max-width: 880px) { .hero-grid { grid-template-columns: 1fr; gap: 40px; } }

  .hero-eyebrow {
    display: flex; align-items: center; gap: 14px;
    margin-bottom: 32px;
  }
  .hero-eyebrow .status {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--fg-muted);
    padding: 6px 12px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgba(255,255,255,0.02);
  }
  .hero-eyebrow .status::before {
    content: ""; width: 6px; height: 6px; border-radius: 50%;
    background: var(--signal); box-shadow: 0 0 8px var(--signal);
    animation: pulse 2s ease-in-out infinite;
  }

  .hero h1 {
    font-variation-settings: "SOFT" 50, "WONK" 0, "opsz" 144;
    font-weight: 350;
  }
  .hero h1 .last { display: block; font-style: italic; color: var(--fg-strong); font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144; font-weight: 300; }
  .hero-tagline {
    margin-top: 28px;
    font-size: clamp(17px, 1.6vw, 21px);
    color: var(--fg-muted);
    max-width: 56ch;
    line-height: 1.5;
  }
  .hero-role {
    margin-top: 18px;
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--accent);
  }

  .hero-side {
    display: flex; flex-direction: column; gap: 28px;
    align-items: stretch;
    align-self: start;
    /* matches eyebrow pill height (~30px) + its margin-bottom (32px) so the
       portrait's top edge sits level with the H1, not with the pill. */
    padding-top: 68px;
  }
  @media (max-width: 880px) { .hero-side { padding-top: 0; } }
  @media (max-width: 880px) { .hero-side { align-items: stretch; max-width: 420px; } }
  .hero-portrait {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 560px;
    margin-left: auto;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--bg-card);
    position: relative;
    cursor: pointer;
    transition: transform 0.5s var(--ease), border-color 0.3s ease;
    box-shadow: 0 30px 80px -30px rgba(0,0,0,0.6);
  }
  @media (max-width: 880px) { .hero-portrait { margin-left: 0; max-width: 360px; } }
  .hero-portrait:hover { transform: scale(1.02); border-color: var(--accent); }
  .hero-portrait img { width: 100%; height: 100%; object-fit: cover; }
  .hero-portrait::after {
    content: "psst — that's me";
    position: absolute; bottom: -28px; left: 0; right: 0;
    text-align: center;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em;
    color: var(--fg-dim); text-transform: uppercase;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .hero-portrait:hover::after { opacity: 1; }

  /* social row — sits below the portrait, centered to its width */
  .socials {
    display: flex; gap: 12px; flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    max-width: 560px;
    margin-left: auto;
  }
  @media (max-width: 880px) { .socials { margin-left: 0; max-width: 360px; } }
  .socials a {
    width: 44px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--fg-muted);
    transition: all 0.25s ease;
  }
  .socials a:hover { color: var(--bg); background: var(--accent); border-color: var(--accent); transform: translateY(-2px); }
  .socials svg { width: 18px; height: 18px; }

  /* cta row */
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 36px; }
  .btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 12px 20px;
    border-radius: 999px;
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    border: 1px solid var(--border-strong);
    transition: all 0.25s ease;
  }
  .btn:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .btn.primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
  .btn.primary:hover { background: var(--fg-strong); color: var(--bg); border-color: var(--fg-strong); }
  .btn .arrow { transition: transform 0.25s ease; }
  .btn:hover .arrow { transform: translateX(3px); }

  /* the EMG band - signature element. Sits inside the hero's extra
     bottom padding so the full waveform is visible above the next section. */
  .emg-band {
    position: absolute; left: 0; right: 0; bottom: 50px;
    height: 110px;
    z-index: -1;
    pointer-events: none;
    opacity: 0.85;
    mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%);
  }
  .emg-band svg { width: 100%; height: 100%; }
  .emg-trace {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px color-mix(in oklab, var(--signal) 40%, transparent));
  }
  .emg-grid line { stroke: var(--border); stroke-width: 0.5; }
  .emg-label {
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em;
    fill: var(--fg-dim); text-transform: uppercase;
  }

  /* scroll cue */
  .scroll-cue {
    position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%);
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--fg-dim);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .scroll-cue::after {
    content: ""; width: 1px; height: 22px;
    background: linear-gradient(to bottom, var(--fg-dim), transparent);
    animation: scrollLine 2.2s ease-in-out infinite;
  }
  @keyframes scrollLine {
    0% { transform: translateY(-100%); opacity: 0; }
    50% { transform: translateY(0); opacity: 1; }
    100% { transform: translateY(100%); opacity: 0; }
  }

  /* ------------------------------------------------------------
     4. about
     ------------------------------------------------------------ */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(36px, 5vw, 72px);
  }
  @media (max-width: 880px) { .about-grid { grid-template-columns: 1fr; } }
  .about-lead {
    font-family: var(--serif); font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.25; color: var(--fg-strong);
    font-weight: 350; letter-spacing: -0.015em;
    font-variation-settings: "SOFT" 30;
  }
  .about-body { color: var(--fg); font-size: 17px; line-height: 1.7; }
  .about-body p { margin-bottom: 1.2em; }
  .about-body p:last-child { margin-bottom: 0; }

  .drivers {
    margin-top: 56px;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px 36px;
    border-top: 1px solid var(--border);
    padding-top: 36px;
  }
  @media (max-width: 700px) { .drivers { grid-template-columns: 1fr; } }
  .driver {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
    display: flex; gap: 16px; align-items: flex-start;
  }
  .driver:last-child, .driver:nth-last-child(2) { border-bottom: 0; }
  @media (max-width: 700px) { .driver:nth-last-child(2) { border-bottom: 1px solid var(--border); } }
  .driver .marker {
    font-family: var(--mono); font-size: 11px; color: var(--accent); letter-spacing: 0.1em;
    padding-top: 4px; flex-shrink: 0;
  }
  .driver h4 { margin-bottom: 4px; }
  .driver p { font-size: 14px; color: var(--fg-muted); margin: 0; line-height: 1.55; }

  /* ------------------------------------------------------------
     5. research agenda cards
     ------------------------------------------------------------ */
  .agenda-intro {
    font-family: var(--serif); font-size: clamp(22px, 2.4vw, 30px);
    color: var(--fg); line-height: 1.35;
    max-width: 60ch;
    margin-bottom: 48px;
    font-weight: 350;
    font-variation-settings: "SOFT" 30;
  }
  .agenda-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .agenda-card {
    background: var(--bg);
    padding: 28px 24px;
    transition: background 0.3s ease;
    position: relative;
  }
  .agenda-card:hover { background: var(--bg-card); }
  .agenda-card .ix {
    position: absolute; top: 16px; right: 18px;
    font-family: var(--mono); font-size: 10px; color: var(--fg-dim); letter-spacing: 0.1em;
  }
  .agenda-card h4 {
    font-family: var(--serif); font-weight: 400; font-size: 22px; line-height: 1.2;
    margin-bottom: 10px;
    color: var(--fg-strong);
    font-variation-settings: "SOFT" 30;
  }
  .agenda-card p {
    font-size: 14px; line-height: 1.6; color: var(--fg-muted);
    margin: 0;
  }
  .agenda-card .glyph {
    font-family: var(--mono); color: var(--accent); font-size: 14px; margin-right: 8px;
  }

  /* ------------------------------------------------------------
     6. publications
     ------------------------------------------------------------ */
  .pub-list { display: flex; flex-direction: column; }
  .pub {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 24px;
    padding: 26px 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
    transition: background 0.3s ease;
    position: relative;
  }
  .pub:first-child { border-top: 1px solid var(--border); }
  @media (max-width: 720px) {
    .pub { grid-template-columns: 1fr; gap: 8px; }
  }
  .pub .venue {
    font-family: var(--mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--accent);
    padding-top: 4px;
  }
  .pub h4 {
    font-family: var(--serif); font-weight: 400; font-size: 22px; line-height: 1.3;
    color: var(--fg-strong); margin-bottom: 6px;
    letter-spacing: -0.01em;
    font-variation-settings: "SOFT" 30;
  }
  .pub .authors { font-size: 13px; color: var(--fg-muted); margin-bottom: 8px; }
  .pub .authors b { color: var(--fg); font-weight: 600; }
  .pub .summary { font-size: 14px; color: var(--fg-muted); line-height: 1.6; max-width: 70ch; }
  .pub .links { display: flex; gap: 8px; align-self: start; padding-top: 6px; flex-wrap: wrap; }
  .pub .links a {
    font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em;
    padding: 7px 13px;
    border: 1px solid var(--border-strong); border-radius: 999px;
    color: var(--fg);
    background: color-mix(in oklab, var(--accent) 8%, transparent);
    font-weight: 500;
    transition: all 0.22s ease;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .pub .links a::after {
    content: "↗"; font-size: 10px; opacity: 0.6;
    transition: transform 0.22s ease, opacity 0.22s ease;
  }
  .pub .links a:hover {
    color: var(--bg); background: var(--accent); border-color: var(--accent);
    transform: translateY(-1px);
  }
  .pub .links a:hover::after { transform: translate(2px, -2px); opacity: 1; }

  /* ------------------------------------------------------------
     7. projects
     ------------------------------------------------------------ */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  @media (max-width: 800px) { .proj-grid { grid-template-columns: 1fr; } }
  .proj {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 32px;
    border-radius: 4px;
    display: flex; flex-direction: column;
    transition: border-color 0.3s ease, transform 0.3s var(--ease);
    position: relative;
    overflow: hidden;
  }
  .proj::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 50% at 100% 0%, color-mix(in oklab, var(--accent) 9%, transparent), transparent 60%);
    opacity: 0; transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .proj:hover { border-color: color-mix(in oklab, var(--accent) 42%, transparent); transform: translateY(-2px); }
  .proj:hover::before { opacity: 1; }
  .proj .tag-row { display: flex; gap: 6px; margin-bottom: 20px; flex-wrap: wrap; }
  .proj h3 { margin-bottom: 12px; }
  .proj .blurb { font-size: 14px; line-height: 1.65; color: var(--fg-muted); margin-bottom: 18px; }
  .proj .meta {
    margin-top: auto; padding-top: 18px;
    border-top: 1px solid var(--border);
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--fg-dim);
  }
  .proj .meta a { color: var(--accent); transition: color 0.2s ease; }
  .proj .meta a:hover { color: var(--fg-strong); }
  .proj .meta a::after { content: " →"; transition: margin 0.2s ease; display: inline-block; }
  .proj .meta a:hover::after { margin-left: 4px; }

  /* ------------------------------------------------------------
     8. experience timeline
     ------------------------------------------------------------ */
  .timeline { position: relative; }
  .tl-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }
  .tl-item:first-child { border-top: 1px solid var(--border); }
  @media (max-width: 700px) {
    .tl-item { grid-template-columns: 1fr; gap: 8px; }
  }
  .tl-date {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent);
    padding-top: 6px;
  }
  .tl-body h4 {
    font-family: var(--serif); font-size: 22px; font-weight: 400; line-height: 1.25;
    color: var(--fg-strong); margin-bottom: 4px;
    font-variation-settings: "SOFT" 30;
  }
  .tl-body .org {
    font-size: 13px; color: var(--fg-muted); margin-bottom: 12px;
    font-family: var(--mono); letter-spacing: 0.06em;
  }
  .tl-body .descr { font-size: 14px; line-height: 1.65; color: var(--fg-muted); max-width: 70ch; }

  /* ------------------------------------------------------------
     9. teaching / outreach
     ------------------------------------------------------------ */
  .outreach-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }
  .outreach-card {
    background: var(--bg);
    padding: 28px 24px;
    transition: background 0.3s ease;
  }
  .outreach-card:hover { background: var(--bg-card); }
  .outreach-card .kind {
    font-family: var(--mono); font-size: 10px; text-transform: uppercase;
    letter-spacing: 0.16em; color: var(--accent);
    margin-bottom: 14px;
  }
  .outreach-card h4 {
    font-family: var(--serif); font-size: 19px; font-weight: 400;
    line-height: 1.25;
    color: var(--fg-strong);
    margin-bottom: 8px;
    font-variation-settings: "SOFT" 30;
  }
  .outreach-card p { font-size: 13px; color: var(--fg-muted); line-height: 1.55; margin: 0; }

  .collab-strip {
    margin-top: 56px;
    padding-top: 36px;
    border-top: 1px solid var(--border);
  }
  .collab-strip h4 {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--fg-dim); margin-bottom: 18px;
  }
  .collab-list {
    display: flex; flex-wrap: wrap; gap: 8px 28px;
    font-family: var(--serif); font-size: 22px; color: var(--fg-muted);
    font-variation-settings: "SOFT" 50;
  }
  .collab-list span { transition: color 0.3s ease; }
  .collab-list span:hover { color: var(--accent); cursor: default; }

  /* ------------------------------------------------------------
     10. contact
     ------------------------------------------------------------ */
  .contact {
    text-align: left;
    padding-bottom: 0;
  }
  .contact-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(36px, 6vw, 80px);
    align-items: end;
  }
  @media (max-width: 800px) { .contact-grid { grid-template-columns: 1fr; } }
  .contact-headline {
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 78px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 350;
    font-variation-settings: "SOFT" 30;
  }
  .contact-headline .accent-italic {
    font-style: italic; color: var(--accent);
    font-variation-settings: "SOFT" 100, "WONK" 1;
    font-weight: 300;
  }
  .contact-meta { font-size: 14px; color: var(--fg-muted); line-height: 1.7; }
  .contact-meta a { color: var(--fg); border-bottom: 1px solid var(--border-strong); padding-bottom: 1px; transition: all 0.2s ease; }
  .contact-meta a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .contact-meta strong { color: var(--fg-strong); font-weight: 600; }
  .contact .email-big {
    margin-top: 32px;
    font-family: var(--mono); font-size: clamp(18px, 2.4vw, 28px);
    color: var(--accent);
    display: inline-block;
    border-bottom: 1px solid color-mix(in oklab, var(--accent) 38%, transparent);
    padding-bottom: 4px;
    transition: all 0.2s ease;
  }
  .contact .email-big:hover { border-bottom-color: var(--accent); letter-spacing: 0.01em; }

  /* footer */
  footer {
    padding: 48px var(--gutter) 36px;
    border-top: 1px solid var(--border);
    margin-top: 100px;
    text-align: center;
  }
  footer .colophon {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--fg-dim);
    max-width: 600px; margin: 0 auto;
    line-height: 1.8;
  }
  footer .colophon b { color: var(--fg-muted); font-weight: 500; }

  /* reveal on scroll */
  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 0.9s var(--ease), transform 0.9s var(--ease); }
  .reveal.in { opacity: 1; transform: none; }
  .reveal-stagger > * { opacity: 0; transform: translateY(16px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); }
  .reveal-stagger.in > * { opacity: 1; transform: none; }
  .reveal-stagger.in > *:nth-child(2) { transition-delay: 60ms; }
  .reveal-stagger.in > *:nth-child(3) { transition-delay: 120ms; }
  .reveal-stagger.in > *:nth-child(4) { transition-delay: 180ms; }
  .reveal-stagger.in > *:nth-child(5) { transition-delay: 240ms; }
  .reveal-stagger.in > *:nth-child(6) { transition-delay: 300ms; }
  .reveal-stagger.in > *:nth-child(7) { transition-delay: 360ms; }
  .reveal-stagger.in > *:nth-child(8) { transition-delay: 420ms; }
  .reveal-stagger.in > *:nth-child(9) { transition-delay: 480ms; }
  .reveal-stagger.in > *:nth-child(10) { transition-delay: 540ms; }
</style>
</head>
