<!-- ============================================================
     SCRIPTS
============================================================ -->
<script>
  // -------- theme toggle (dark default, persists in localStorage,
  // respects prefers-color-scheme on first visit)
  (function theme() {
    const root = document.documentElement;
    const KEY = 'ks-theme';
    const stored = (() => { try { return localStorage.getItem(KEY); } catch (_) { return null; } })();
    const prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
    const initial = stored || (prefersLight ? 'light' : 'dark');
    if (initial === 'light') root.setAttribute('data-theme', 'light');

    const btn = document.getElementById('themeToggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isLight = root.getAttribute('data-theme') === 'light';
      if (isLight) {
        root.removeAttribute('data-theme');
        try { localStorage.setItem(KEY, 'dark'); } catch (_) {}
      } else {
        root.setAttribute('data-theme', 'light');
        try { localStorage.setItem(KEY, 'light'); } catch (_) {}
      }
    });
  })();

  // -------- nav scroll state
  const nav = document.getElementById('nav');
  let lastY = 0;
  const onScroll = () => {
    const y = window.scrollY;
    nav.classList.toggle('scrolled', y > 40);
    lastY = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // -------- reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
  document.querySelectorAll('.reveal, .reveal-stagger').forEach(el => io.observe(el));

  // -------- live EMG waveform
  // generates a synthetic EMG-ish trace that scrolls; mixes pink noise w/ occasional bursts.
  // It's not a real EMG model — just visually evocative and rhythmically right.
  (function emg() {
    const path = document.getElementById('emgPath');
    if (!path) return;
    const W = 1400, H = 120;
    const CENTRE = H / 2;
    const SAMPLES = 700;        // points across the band
    const DX = W / SAMPLES;
    const BUFFER = new Array(SAMPLES).fill(CENTRE);

    // gentle pink-ish noise (smoothed white)
    let lastNoise = 0;
    function noise() {
      const w = (Math.random() - 0.5) * 2;
      lastNoise = lastNoise * 0.72 + w * 0.28;
      return lastNoise;
    }

    // burst envelope (Hann-like)
    let burst = null;
    function maybeStartBurst() {
      if (burst) return;
      if (Math.random() < 0.018) {       // burst probability per frame
        burst = {
          t: 0,
          len: 14 + Math.floor(Math.random() * 22),
          amp: 22 + Math.random() * 26,
          freq: 0.55 + Math.random() * 0.45
        };
      }
    }
    function burstSample() {
      if (!burst) return 0;
      const u = burst.t / burst.len;
      const env = 0.5 - 0.5 * Math.cos(Math.PI * 2 * u); // Hann
      const carrier = Math.sin(burst.t * burst.freq * Math.PI);
      const sub = Math.sin(burst.t * burst.freq * Math.PI * 2.7) * 0.4;
      const v = burst.amp * env * (carrier + sub);
      burst.t += 1;
      if (burst.t > burst.len) burst = null;
      return v;
    }

    let frame = 0;
    function tick() {
      maybeStartBurst();
      // slow baseline drift
      const drift = Math.sin(frame * 0.006) * 3;
      const baseline = noise() * 4;
      const b = burstSample();
      // shift buffer left, append new value
      BUFFER.shift();
      BUFFER.push(CENTRE + drift + baseline + b);

      // build d
      let d = 'M 0 ' + BUFFER[0].toFixed(2);
      for (let i = 1; i < SAMPLES; i++) {
        d += ' L ' + (i * DX).toFixed(2) + ' ' + BUFFER[i].toFixed(2);
      }
      path.setAttribute('d', d);
      frame++;
      requestAnimationFrame(tick);
    }
    // respect reduced motion
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      // draw a single static trace
      for (let i = 0; i < SAMPLES; i++) BUFFER[i] = CENTRE + Math.sin(i * 0.08) * 6 + (Math.random()-0.5) * 3;
      let d = 'M 0 ' + BUFFER[0].toFixed(2);
      for (let i = 1; i < SAMPLES; i++) d += ' L ' + (i * DX).toFixed(2) + ' ' + BUFFER[i].toFixed(2);
      path.setAttribute('d', d);
    } else {
      tick();
    }
  })();

  // -------- portrait click easter egg
  // toggles a subtle filter to give a "you've found me" beat. Replace src logic if a second photo exists.
  (function portrait() {
    const wrap = document.getElementById('portrait');
    const img = document.getElementById('portraitImg');
    if (!wrap || !img) return;
    let toggled = false;
    wrap.addEventListener('click', () => {
      toggled = !toggled;
      img.style.transition = 'filter 0.5s ease';
      img.style.filter = toggled
        ? 'grayscale(1) contrast(1.15) brightness(1.05) sepia(0.15)'
        : 'none';
    });
  })();

  // -------- year in footer (drift-safe)
  // (kept as static '© 2026' above; if you want auto, replace with new Date().getFullYear())
</script>

</body>
</html>
